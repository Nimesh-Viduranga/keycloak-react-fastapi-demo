# FastAPI API — JWT validation only (SPA owns OIDC)

# --- Mode A: nginx stack ---
# App URL: http://localhost:8088
FRONTEND_URL=http://localhost:8088
CORS_ORIGINS=http://localhost:8088,http://localhost:5173

# --- Mode B: Vite + uvicorn (optional) ---
# FRONTEND_URL=http://localhost:5173

# Keycloak (JWT issuer / JWKS)
KEYCLOAK_BASE_URL=http://localhost:8090
KEYCLOAK_REALM=brandvisual
KEYCLOAK_CLIENT_ID=react-fastapi-demo
