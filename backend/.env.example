# FastAPI BFF — used for local Vite/uvicorn OR as defaults (compose overrides URLs)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Mode A: nginx stack (recommended / BrandVisual-like) ---
# App URL: http://localhost:8088
FRONTEND_URL=http://localhost:8088
BACKEND_URL=http://localhost:8088
PUBLIC_URL=http://localhost:8088

# --- Mode B: Vite + uvicorn without nginx (optional) ---
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# PUBLIC_URL=http://localhost:5173

# Keycloak (this project's compose — NOT MyPage)
KEYCLOAK_BASE_URL=http://localhost:8090
KEYCLOAK_REALM=brandvisual
KEYCLOAK_CLIENT_ID=react-fastapi-demo
# MUST match Keycloak Admin → brandvisual → Clients → react-fastapi-demo → Credentials
# (realm import may generate a secret different from brandvisual-demo-secret)
KEYCLOAK_CLIENT_SECRET=replace-me-from-keycloak-credentials-tab
